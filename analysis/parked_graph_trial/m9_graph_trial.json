    {"test": "2022 A", "item": "1", "group": "sample", "answer": "6", "types": ["vyraz-mocniny-odmocniny"], "steps": [
      ["Zlomek: nejdřív celý čitatel, pak jmenovatel, nakonec vydělit.", "vyraz-mocniny-odmocniny"],
      ["7² = 49", "druha-mocnina"],
      ["√(7²) = √49 = 7", "druha-odmocnina"],
      ["Čitatel: 49 − 7 = 42, jmenovatel: √49 = 7", "zlomkova-cara-zavorka"],
      ["42 : 7 = 6", "zlomek-pojem"]]},
    {"test": "2023 D", "item": "3.3", "group": "sample", "answer": "1/8", "types": ["slozeny-zlomek"], "steps": [
      ["Čitatel a jmenovatel velkého zlomku spočítat zvlášť, potom je vydělit.", "slozeny-zlomek"],
      ["Čitatel: 6/7 − 9/14 = 12/14 − 9/14 = 3/14", "zlomky-scitani"],
      ["Ve jmenovateli má dělení přednost před sčítáním.", "poradi-operaci"],
      ["6/7 : 3/2 = 6/7 · 2/3 = 4/7", "zlomky-deleni"],
      ["Jmenovatel: 8/7 + 4/7 = 12/7", "zlomky-scitani"],
      ["Hlavní zlomková čára je dělení: 3/14 : 12/7", "zlomkova-cara-zavorka"],
      ["3/14 · 7/12 = 1/8 (krátit 3 a 12, 7 a 14)", "zlomky-deleni"]]},
    {"test": "2025 A", "item": "8.3", "group": "sample", "answer": "39", "types": ["opakovani-skupina"], "steps": [
      ["Po obvodu se opakuje stejná skupina: několik červených a 2 bílé. Skupin je celý počet, takže velikost skupiny dělí 65.", "opakovani-skupina"],
      ["65 = 5 · 13, dělitelé jsou 1, 5, 13 a 65.", "delitele"],
      ["Skupina má aspoň 3 rostliny a skupin je víc než jedna: ve skupině je 5 nebo 13 rostlin.", "vsechny-moznosti"],
      ["Skupin je 13 nebo 5, bílých 26 nebo 10, červených 39 nebo 55.", "vsechny-moznosti"],
      ["Nejmenší z možných počtů je 39.", "nejmensi-nejvetsi"]]},
    {"test": "2024 B", "item": "1", "group": "sample", "answer": "1,5 km", "types": ["slovni-uloha-jednotky"], "steps": [
      ["Rozdíl délek kroků vynásobit počtem kroků a výsledek převést na kilometry.", "slovni-uloha-jednotky"],
      ["75 − 60 = 15 cm na každém kroku", "o-kolik-rozdil"],
      ["15 · 10 000 = 150 000 cm", "nasobeni-mocninou-deseti"],
      ["150 000 cm = 1 500 m = 1,5 km", "jednotky-delky"]]},
    {"test": "2026 B", "item": "3.2", "group": "sample", "answer": "b · (a − 1)", "types": ["rozklad-vytykanim"], "steps": [
      ["Nejdřív výraz upravit, teprve potom vytýkat.", "rozklad-vytykanim"],
      ["(a − 2b) · b = ab − 2b²", "roznasobeni-jednoclenem"],
      ["ab − 2b² − b + 2b² = ab − b", "podobne-cleny"],
      ["ab − b = b · (a − 1); po vytknutí b z b zůstane 1", "vytykani"]]},
    {"test": "2023 C", "item": "5.2", "group": "sample", "answer": "y = 0,3", "types": ["rovnice-se-zlomky"], "steps": [
      ["Zlomků se zbavit vynásobením celé rovnice společným jmenovatelem.", "rovnice-se-zlomky"],
      ["Nejmenší společný násobek 6, 4 a 2 je 12.", "nsn"],
      ["Každý člen krát 12: 12y + 10y = 3 · (2y − 1) + 6 · (y + 1); čitatel se násobí celý.", "zlomkova-cara-zavorka"],
      ["3 · (2y − 1) + 6 · (y + 1) = 6y − 3 + 6y + 6", "roznasobeni-jednoclenem"],
      ["22y = 12y + 3", "podobne-cleny"],
      ["10y = 3, y = 3/10 = 0,3", "ekvivalentni-upravy"]]},
    {"test": "2025 D", "item": "1", "group": "sample", "answer": "135 cm", "types": ["zlomek-ze-zbytku"], "steps": [
      ["Druhý zlomek se počítá ze zbytku, ne z celé stuhy.", "zlomek-ze-zbytku"],
      ["3 m = 300 cm", "jednotky-delky"],
      ["Čtvrtina z 300 cm je 75 cm.", "zlomek-z-cisla"],
      ["Zbytek: 300 − 75 = 225 cm", "casti-a-celek"],
      ["Dvě pětiny z 225 cm: 225 : 5 · 2 = 90 cm", "zlomek-z-cisla"],
      ["Třetí díl: 225 − 90 = 135 cm", "casti-a-celek"]]},
    {"test": "2024 C", "item": "14", "group": "sample", "answer": "E (27)", "types": ["slovni-uloha-rovnice"], "steps": [
      ["Neznámá x je počet Cyrilových komiksů, protože s ním se oba ostatní porovnávají.", "slovni-uloha-rovnice"],
      ["Petr: x + 3", "o-kolik-vyraz"],
      ["Honza: x + x/8 = 9/8 · x", "o-zlomek-vice"],
      ["Petr a Honza přečetli stejně: x + 3 = 9/8 · x", "slovni-uloha-rovnice"],
      ["3 = x/8, x = 24", "ekvivalentni-upravy"],
      ["Ptají se na Petra: 24 + 3 = 27", "odpoved-na-otazku"]]},
    {"test": "2026 B", "item": "15.3", "group": "sample", "answer": "E (18 kg)", "types": ["procenta-soucet"], "steps": [
      ["Větší závaží x, menší vyjádřit procentem z něj, součet je 42 kg.", "procenta-soucet"],
      ["Základ je větší závaží, protože stojí za „než“.", "procenta-zaklad"],
      ["O 60 % lehčí znamená 0,4 · x.", "procenta-nasobitel"],
